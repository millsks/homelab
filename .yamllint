---
extends: default

rules:
  # Prose-bearing YAML in this repo (sprint tracking, Ansible with explanatory
  # comments) carries long explanatory lines on purpose. Readability of the
  # comment beats an arbitrary column limit.
  line-length:
    max: 160
    allow-non-breakable-words: true
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false

  # Required by ansible-lint, which reads this file and refuses its own fix mode
  # if these three rules disagree with it. Octal values are the substantive one,
  # and it is a real footgun in Ansible:
  #   - forbid-implicit-octal rejects bare 0644, which reads as a file mode to a
  #     human and parses as the integer 420.
  #   - forbid-explicit-octal rejects 0o644, which parses as 420 too — correct
  #     YAML, still the wrong value once Ansible wants a mode string.
  # If either fires, the fix is to quote it: mode: "0644".
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

# Vendored trees and generated output: not ours to hold to our house style.
# _bmad-output/ is regenerated by BMAD tooling that does not emit a document-start
# marker, so linting it means two tools fighting over one file's formatting.
ignore: |
  _bmad-output/
  .pixi/
  _bmad/
  .claude/
  .agents/
  .bmad-loop/
  .github/
