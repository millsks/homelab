.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/
# pixi environments
.pixi/*
!.pixi/config.toml

# Python build artefacts, created by importing or running the harness in src/
__pycache__/
*.py[cod]
*.egg-info/

# tool caches, all created by `pixi run ci`
.ruff_cache/
.mypy_cache/
.pytest_cache/
.ansible/

# coverage output from `pixi run cov`
.coverage
.coverage.*
coverage.xml
htmlcov/

# the record `pixi run drift` writes. The run is evidence; the file is a
# per-run artefact, published by CI rather than committed.
drift-record.json
converge-record.json
*-record.json

# age identities: the half that DECRYPTS everything .sops.yaml encrypts. It is escrowed outside
# this Repository (runbooks/l0-physical/repo-secrets.md § Escrow) and belongs in no clone of it.
# Ignoring is a backstop, never the control — `pixi run secrets` rejects the key by its own
# AGE-SECRET-KEY-1 format wherever it is put, because .gitignore only helps for the names it
# happens to predict. NOT `.sops.yaml`, which is the public policy and must be COMMITTED.
*.agekey
*.age.key
age-key.txt
keys.txt
sops-age-key*

# OpenTofu working directories, created by `tofu init` in any root module that
# has .tf files. NOT .terraform.lock.hcl — that file records the exact provider
# versions resolved, AD-20 requires exact pins, and it must be COMMITTED.
.terraform/

# OpenTofu state and variables. State holds every attribute of every resource,
# including ones the providers mark sensitive; tfvars is where credentials get
# passed in. This repository is public — nothing here may ever be committed.
*.tfstate
*.tfstate.*
*.tfvars
.terraform.tfstate.lock.info
crash.log
